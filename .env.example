# Spotify Developer API Credentials (Optional if using built-in discovery)
RSPOTIFY_CLIENT_ID=your_spotify_client_id_here
RSPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
RSPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Listening Room Diagnostics & Crash Proxy (Cloudflare Worker)
# Format: https://<worker-name>.<account-subdomain>.workers.dev
VITE_DIAGNOSTICS_PROXY_URL=
