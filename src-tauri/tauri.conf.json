{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listening Room",
  "version": "0.2.3",
  "identifier": "com.listeningroom.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Listening Room",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 380,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost data: blob:; media-src 'self' blob: data: asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A spatial Spotify listening room",
    "longDescription": "A spatial Spotify player and vinyl listening room featuring realistic and classic vinyl turntables, audio visualizers, and customizable live backgrounds.",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
